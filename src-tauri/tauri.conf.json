{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xhub",
  "version": "0.1.1",
  "identifier": "com.trig.xhub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Xhub",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: asset:; connect-src 'self' https://github.com https://objects.githubusercontent.com;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBEMEI0NjM3MDFCMUIxNkMKUldSc3NiRUJOMFlMRGFBb3djanpOZzIrVE5GVFhhMjZhTjhtdE9qVHNNVzRFRk9rbzExTFZsM1gK",
      "endpoints": [
        "https://github.com/trinhhaox/x-hub/releases/latest/download/latest.json"
      ]
    }
  }
}
